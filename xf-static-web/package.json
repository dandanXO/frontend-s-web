{
  "name": "xf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "cross-env NODE_ENV=development dotenv -e .env.development vue-cli-service serve",
    "serve:test": "cross-env NODE_ENV=development dotenv -e .env.test vue-cli-service serve",
    "serve:staging": "cross-env NODE_ENV=development dotenv -e .env.staging vue-cli-service serve",
    "build": "cross-env NODE_ENV=production  dotenv -e .env.production vue-cli-service build",
    "build:dev": "cross-env NODE_ENV=development  dotenv -e .env.development vue-cli-service build",
    "build:test": "cross-env NODE_ENV=development  dotenv -e .env.test vue-cli-service build",
    "build:staging": "cross-env NODE_ENV=production  dotenv -e .env.staging vue-cli-service build",
    "build:prod": "cross-env NODE_ENV=production  dotenv -e .env.production vue-cli-service build",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@fingerprintjs/fingerprintjs": "^3.4.0",
    "@fingerprintjs/fingerprintjs-pro-vue-v3": "^1.5.0",
    "@vueuse/core": "^10.10.0",
    "ant-design-vue": "^2.2.8",
    "aos": "^3.0.0-beta.6",
    "axios": "^1.3.2",
    "core-js": "^3.8.3",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.0.0",
    "element-plus": "^2.9.10",
    "moment": "^2.29.4",
    "pinia": "^2.0.30",
    "vue": "^3.2.13",
    "vue-qrcode-component": "^2.1.1",
    "vue-qrious": "^3.1.0",
    "vue-remix-icons": "^1.1.1",
    "vue-router": "^4.0.3",
    "vue3-autocounter": "1.0.6",
    "vue3-carousel": "^0.2.9",
    "vue3-marquee": "^3.1.2",
    "vue3-number-counter": "^0.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "sass": "^1.58.0",
    "sass-loader": "^13.2.0",
    "terser-webpack-plugin": "^5.3.10"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
