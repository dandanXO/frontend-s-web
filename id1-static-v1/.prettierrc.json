{
  "singleQuote": false,
  "printWidth": 120,
  "editor.formatOnSave": true,
  "proseWrap": "always",
  "tabWidth": 2,
  "requireConfig": false,
  "useTabs": false,
  "trailingComma": "none",
  "bracketSpacing": true,
  "jsxBracketSameLine": false,
  "semi": true,
  "htmlWhitespaceSensitivity": "ignore",
  "importOrder": ["^vue$", "^quasar/", "^[./]", "^@/", "^[a-z]", "^[^./]", "^[^a-z]"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
